{
  "name": "obsidian-money-manager",
  "version": "0.1.0",
  "description": "A local Markdown financial ledger for Obsidian.",
  "type": "module",
  "main": "main.js",
  "bin": {
    "money-manager": "dist/money-manager.mjs"
  },
  "files": ["dist/money-manager.mjs"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devctllabs/obsidian-money-manager.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "prepare": "node scripts/prepare-cli.mjs",
    "build:cli": "node esbuild.cli.config.mjs",
    "test:cli:install": "node scripts/check-cli-install.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"test/**/*.ts\" \".storybook/**/*.{ts,tsx}\" \"*.{mjs,mts,ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"test/**/*.ts\" \".storybook/**/*.{ts,tsx}\" \"*.{mjs,mts,ts,tsx}\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint src",
    "test": "vitest run --project unit --project cli",
    "test:unit": "vitest run --project unit --project cli",
    "test:performance": "vitest run --project performance",
    "test:release-helper": "python3 -m unittest discover -s .github/scripts/tests -t .github/scripts",
    "test:storybook": "vitest run --project storybook",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "build": "pnpm typecheck && node esbuild.config.mjs production",
    "test:e2e:run": "wdio run ./wdio.conf.mts",
    "test:e2e": "pnpm build && pnpm test:e2e:run",
    "test:e2e:headless": "node scripts/run-e2e-headless.mjs",
    "test:e2e:mobile:headless": "node scripts/run-e2e-headless.mjs --mobile",
    "test:e2e:mobile": "pnpm build && OBSIDIAN_E2E_PROFILE=mobile pnpm test:e2e:run",
    "quality:architecture": "depcruise src --output-type err-long",
    "quality:dead-code": "knip --no-exit-code --no-config-hints",
    "quality": "pnpm quality:architecture && pnpm quality:dead-code",
    "verify:release": "node scripts/verify-release.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm quality && pnpm typecheck && pnpm test:unit && pnpm test:performance && pnpm test:storybook && pnpm build:storybook && pnpm build && pnpm build:cli && pnpm verify:release",
    "check:full": "pnpm format:check && pnpm lint && pnpm quality && pnpm typecheck && pnpm test:unit && pnpm test:performance && pnpm test:storybook && pnpm build:storybook && pnpm build && pnpm build:cli && pnpm verify:release && pnpm test:e2e:headless",
    "package:release": "pnpm verify:release && node scripts/package-release.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "license": "MIT",
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.4",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.17",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@wdio/cli": "^9.31.9",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.9",
    "@wdio/mocha-framework": "^9.31.9",
    "dependency-cruiser": "^18.2.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-storybook": "^10.5.10",
    "globals": "^17.11.0",
    "jiti": "^2.6.1",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "mocha": "^10.8.2",
    "obsidian": "^1.13.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.8",
    "storybook": "^10.5.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wdio-obsidian-reporter": "^3.2.1",
    "wdio-obsidian-service": "^3.2.1"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
